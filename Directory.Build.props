<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>0.11.0-p11.0</Version>
    <RepositoryUrl>https://github.com/walidatiyaai2025-gif/MAM</RepositoryUrl>
    <Authors>Diwan Al Amiri MAM</Authors>
    <Product>Diwan Al Amiri Media Asset Management</Product>
    <MamCommitSha Condition="'$(SourceRevisionId)' == ''">local</MamCommitSha>
    <MamCommitSha Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</MamCommitSha>
    <MamBuildNumber Condition="'$(MamBuildNumber)' == ''">local</MamBuildNumber>
    <MamBuildTimestampUtc Condition="'$(MamBuildTimestampUtc)' == ''">not-stamped</MamBuildTimestampUtc>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="MamCommitSha" Value="$(MamCommitSha)" />
    <AssemblyMetadata Include="MamBuildNumber" Value="$(MamBuildNumber)" />
    <AssemblyMetadata Include="MamBuildTimestampUtc" Value="$(MamBuildTimestampUtc)" />
  </ItemGroup>
</Project>
