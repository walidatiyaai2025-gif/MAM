{
  "Environment": {
    "Name": "Production",
    "SiteCode": "DA-KW",
    "DisplayNameAr": "نظام إدارة الأصول الإعلامية - الديوان الأميري",
    "DisplayNameEn": "Diwan Al Amiri Media Asset Management",
    "TimeZone": "Asia/Kuwait",
    "DefaultCulture": "ar-KW",
    "SupportedCultures": ["ar-KW", "en-US"]
  },
  "Server": {
    "PublicBaseUrl": "https://REPLACE-WITH-PRODUCTION-FQDN",
    "ApiBasePath": "/api",
    "MaxRequestBodyMB": 256,
    "RequestTimeoutSeconds": 120
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringSecretRef": "REPLACE-WITH-SECRET-REFERENCE",
    "CommandTimeoutSeconds": 60,
    "EnableRetryOnFailure": true,
    "MigrationMode": "Explicit",
    "BackupPolicyId": "REPLACE-WITH-DB-BACKUP-POLICY"
  },
  "Storage": {
    "Primary": {
      "Id": "PRIMARY-01",
      "Type": "SMB",
      "Root": "REPLACE-WITH-PRIMARY-STORAGE-ROOT",
      "CredentialRef": "REPLACE-WITH-SECRET-REFERENCE-OR-SERVICE-IDENTITY",
      "OriginalsPrefix": "originals",
      "DerivativesPrefix": "derivatives",
      "MinimumFreeGB": 0,
      "MinimumFreePercent": 10,
      "PathLayout": "yyyy/MM/{AssetId}"
    },
    "Backup": {
      "Id": "BACKUP-01",
      "Type": "SMB",
      "Root": "REPLACE-WITH-BACKUP-STORAGE-ROOT",
      "CredentialRef": "REPLACE-WITH-SECRET-REFERENCE-OR-SERVICE-IDENTITY",
      "MinimumFreeGB": 0,
      "CopyOriginals": true,
      "CopyDerivatives": false,
      "VerifyChecksum": true,
      "MaxRetryCount": 10
    }
  },
  "Upload": {
    "ChunkSizeMB": 16,
    "MaxConcurrentFilesPerClient": 3,
    "MaxFileSizeGB": 0,
    "ResumeEnabled": true,
    "SessionExpiryHours": 72,
    "ChecksumAlgorithm": "SHA256",
    "DuplicatePolicy": "DetectAndPrompt",
    "WebEnabled": true,
    "QuarantineUnknownFiles": true
  },
  "Capture": {
    "Enabled": false,
    "Provider": "REPLACE-WITH-CERTIFIED-PROVIDER",
    "DeviceId": "REPLACE-WITH-CERTIFIED-DEVICE",
    "Input": "REPLACE-WITH-SDI-HDMI-ETC",
    "VideoProfile": "REPLACE-WITH-APPROVED-VIDEO-PROFILE",
    "AudioProfile": "REPLACE-WITH-APPROVED-AUDIO-PROFILE",
    "TimecodeSource": "REPLACE-WITH-APPROVED-TIMECODE-SOURCE",
    "Container": "REPLACE-WITH-APPROVED-CONTAINER",
    "Codec": "REPLACE-WITH-APPROVED-CODEC",
    "DroppedFrameThreshold": 0,
    "RequireLivePreview": true,
    "RequireAudioMeters": true,
    "RequireTapeId": true,
    "AutoUploadAfterStop": true
  },
  "Desktop": {
    "IngestCache": {
      "Root": "D:\\DiwanMAM\\IngestCache",
      "MinimumFreeGB": 0,
      "ReservePercent": 10,
      "DeleteAfterPrimaryVerified": false,
      "RetentionHoursAfterSuccess": 24,
      "RetentionDaysAfterFailure": 7
    }
  },
  "Jobs": {
    "MaxConcurrentMediaJobsPerWorker": 1,
    "MaxConcurrentBackupJobsPerWorker": 1,
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "StaleJobRecoveryEnabled": true
  },
  "Search": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "HighlightMatches": true,
    "FacetsEnabled": true,
    "IncludeArchivedByDefault": false
  },
  "Auth": {
    "Mode": "REPLACE-WITH-ActiveDirectory-OIDC-OR-Local",
    "SessionIdleMinutes": 30,
    "AbsoluteSessionHours": 12,
    "AllowRememberMe": false
  },
  "Retention": {
    "SoftDeleteEnabled": true,
    "RecycleDays": 0,
    "RequireApprovalForPermanentDelete": true,
    "LegalHoldEnabled": true,
    "RequireReasonForDelete": true
  },
  "Audit": {
    "Enabled": true,
    "RetentionDays": 0,
    "LogDownloads": true,
    "LogSettingsChanges": true,
    "LogSecurityEvents": true
  },
  "Brand": {
    "OrganizationNameAr": "الديوان الأميري",
    "OrganizationNameEn": "REPLACE-WITH-OFFICIALLY-APPROVED-ENGLISH-NAME",
    "ProductNameAr": "نظام إدارة الأصول الإعلامية",
    "ProductNameEn": "Media Asset Management",
    "PrimaryLogoAsset": "REPLACE-WITH-OFFICIAL-ASSET",
    "CompactLogoAsset": "REPLACE-WITH-OFFICIAL-ASSET",
    "AppIconAsset": "REPLACE-WITH-OFFICIAL-ASSET",
    "FaviconAsset": "REPLACE-WITH-OFFICIAL-ASSET",
    "PrimaryColor": "REPLACE-WITH-APPROVED-BRAND-COLOR",
    "SecondaryColor": "REPLACE-WITH-APPROVED-BRAND-COLOR",
    "AccentColor": "REPLACE-WITH-APPROVED-BRAND-COLOR",
    "ArabicFontFamily": "REPLACE-WITH-APPROVED-LICENSED-FONT",
    "EnglishFontFamily": "REPLACE-WITH-APPROVED-LICENSED-FONT",
    "ShowEnvironmentBadge": false
  }
}
