{
  "Environment": {
    "Name": "Development",
    "SiteCode": "DA-DEV",
    "DisplayNameAr": "نظام إدارة الأصول الإعلامية - الديوان الأميري",
    "DisplayNameEn": "Diwan Al Amiri Media Asset Management",
    "TimeZone": "Asia/Kuwait",
    "DefaultCulture": "ar-KW",
    "SupportedCultures": ["ar-KW", "en-US"]
  },
  "Server": {
    "PublicBaseUrl": "https://localhost:7443",
    "ApiBasePath": "/api",
    "AllowedOrigins": ["https://localhost:7443"],
    "MaxRequestBodyMB": 256,
    "RequestTimeoutSeconds": 120,
    "ForwardedHeaders": { "Enabled": false },
    "Health": { "EndpointEnabled": true }
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringSecretRef": "development-user-secrets:Database",
    "CommandTimeoutSeconds": 60,
    "EnableRetryOnFailure": true,
    "MigrationMode": "Explicit",
    "BackupPolicyId": "DEV-DB-BACKUP"
  },
  "Storage": {
    "Primary": {
      "Id": "DEV-PRIMARY",
      "Type": "Mock",
      "Root": ".mam-dev/primary",
      "OriginalsPrefix": "originals",
      "DerivativesPrefix": "derivatives",
      "MinimumFreeGB": 1,
      "MinimumFreePercent": 5,
      "WriteTestOnHealthCheck": true,
      "PathLayout": "yyyy/MM/{AssetId}"
    },
    "Backup": {
      "Id": "DEV-BACKUP",
      "Type": "Mock",
      "Root": ".mam-dev/backup",
      "MinimumFreeGB": 1,
      "CopyOriginals": true,
      "CopyDerivatives": false,
      "VerifyChecksum": true,
      "MaxRetryCount": 3,
      "RetryBackoffSeconds": 5,
      "IntegrityRecheckSchedule": "Daily"
    }
  },
  "Desktop": {
    "IngestCache": {
      "Root": ".mam-dev/ingest-cache",
      "MinimumFreeGB": 1,
      "ReservePercent": 10,
      "DeleteAfterPrimaryVerified": true,
      "RetentionHoursAfterSuccess": 24,
      "RetentionDaysAfterFailure": 7,
      "EncryptionRequired": false
    }
  },
  "Upload": {
    "ChunkSizeMB": 16,
    "MaxConcurrentFilesPerClient": 3,
    "MaxFileSizeGB": 500,
    "ResumeEnabled": true,
    "SessionExpiryHours": 72,
    "ChecksumAlgorithm": "SHA256",
    "DuplicatePolicy": "DetectAndPrompt",
    "WebEnabled": true,
    "WebMaxConcurrentFiles": 3,
    "AllowedExtensions": [".mxf", ".mov", ".mp4", ".wav", ".jpg", ".jpeg", ".png", ".pdf"],
    "QuarantineUnknownFiles": true
  },
  "Capture": {
    "Enabled": false,
    "WorkstationId": "",
    "Provider": "",
    "DeviceId": "",
    "Input": "",
    "VideoProfile": "",
    "AudioProfile": "",
    "TimecodeSource": "",
    "Container": "",
    "Codec": "",
    "DroppedFrameThreshold": 0,
    "RequireLivePreview": true,
    "RequireAudioMeters": true,
    "RequireTapeId": true,
    "AutoUploadAfterStop": true
  },
  "Jobs": {
    "MaxConcurrentMediaJobsPerWorker": 2,
    "MaxConcurrentBackupJobsPerWorker": 2,
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "MaxAttempts": 5,
    "StaleJobRecoveryEnabled": true,
    "FailedJobRetentionDays": 30
  },
  "Search": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "HighlightMatches": true,
    "FacetsEnabled": true,
    "IncludeArchivedByDefault": false
  },
  "Auth": {
    "Mode": "Local",
    "SessionIdleMinutes": 30,
    "AbsoluteSessionHours": 12,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RequireMfa": false,
    "AllowRememberMe": false
  },
  "Retention": {
    "SoftDeleteEnabled": true,
    "RecycleDays": 30,
    "RequireApprovalForPermanentDelete": true,
    "LegalHoldEnabled": true,
    "RequireReasonForDelete": true,
    "PurgePrimaryAndBackupTogether": true
  },
  "Audit": {
    "Enabled": true,
    "RetentionDays": 365,
    "LogReads": "Selective",
    "LogDownloads": true,
    "LogSettingsChanges": true,
    "LogSecurityEvents": true,
    "ExportEnabled": true
  },
  "Logging": {
    "MinimumLevel": "Information",
    "FileRetentionDays": 30,
    "IncludeSensitiveMetadata": false,
    "CorrelationIdEnabled": true
  },
  "Diagnostics": {
    "ClientBundleEnabled": true
  },
  "Brand": {
    "OrganizationNameAr": "الديوان الأميري",
    "OrganizationNameEn": "Diwan Al Amiri",
    "ProductNameAr": "نظام إدارة الأصول الإعلامية",
    "ProductNameEn": "Media Asset Management",
    "PrimaryLogoAsset": "assets/branding/diwan-al-amiri-logo.png",
    "CompactLogoAsset": "assets/branding/diwan-al-amiri-logo.png",
    "AppIconAsset": "assets/branding/diwan-al-amiri-app-icon.ico",
    "FaviconAsset": "assets/branding/diwan-al-amiri-favicon.svg",
    "PrimaryColor": "#0A2342",
    "SecondaryColor": "#B58A2A",
    "AccentColor": "#C6A15B",
    "NavyDeep": "#07182E",
    "NavyHover": "#12365A",
    "GoldPressed": "#99731F",
    "GoldSoft": "#E0C98A",
    "DangerColor": "#B42318",
    "WarningColor": "#B54708",
    "SuccessColor": "#027A48",
    "ArabicFontFamily": "Segoe UI",
    "EnglishFontFamily": "Segoe UI",
    "PreserveLogoOriginalColors": true,
    "ShowEnvironmentBadge": true
  }
}
